# Copy to `.env` for local development with docker compose.
# Never commit `.env`. These are local-only defaults; on Railway, set the
# production equivalents shown in README.md as project variables instead
# (there OPERATELY_HOST/DATABASE_URL use Railway's ${{ }} reference syntax,
# which is not valid inside a plain .env file read by docker compose).

PORT=4000
VERSION=1.8.0

DATABASE_URL=ecto://operately:operately@db:5432/operately   # points at the local `db` service below
SECRET_KEY_BASE=replace-with-strong-random-value   # generate locally: openssl rand -hex 32
OPERATELY_BLOB_TOKEN_SECRET_KEY=replace-with-strong-random-value   # generate locally: openssl rand -base64 32
SYSTEM_SETTINGS_ENCRYPTION_KEYS=replace-with-strong-random-value   # generate locally: openssl rand -hex 32
OPERATELY_HOST=localhost
OPERATELY_URL_SCHEME=http   # no TLS on localhost
ALLOW_LOGIN_WITH_EMAIL=yes
ALLOW_SIGNUP_WITH_EMAIL=yes
